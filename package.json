{
    "name": "lifetimesoft-web",
    "scripts": {
        "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./public/css/style.css --minify",
        "build:js": "npx esbuild src/alpine.js --bundle --minify --outfile=public/js/alpine.js",
        "build": "npm run build:css && npm run build:js",
        "dev": "wrangler dev src/index.tsx --remote",
        "deploy": "npm run build && wrangler deploy --minify src/index.tsx"
    },
    "dependencies": {
        "hono": "^4.6.16"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20241218.0",
        "@tailwindcss/cli": "^4.2.2",
        "alpinejs": "^3.15.11",
        "esbuild": "^0.28.0",
        "tailwindcss": "^4.2.2",
        "wrangler": "^4.0.0"
    }
}
